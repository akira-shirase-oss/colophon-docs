#!/usr/bin/env bash
# The gate before every push (scripts/check.sh), run by git itself: a failing gate blocks the push.
# Enable it once per clone with `npm run hooks` (git config core.hooksPath scripts/hooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! scripts/check.sh; then
  echo "pre-push: scripts/check.sh failed; the push is blocked. Fix it and push again." >&2
  exit 1
fi
