{
  "name": "colophon-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Documentation for Colophon, the open-source headless CMS: guides, the API reference and the changelog.",
  "license": "MIT",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-urls.mjs && node scripts/copy-scalar.mjs && astro build && node scripts/focusable-tables.mjs && node scripts/csp-hashes.mjs && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "check:openapi": "node scripts/sync-openapi.mjs --check",
    "snippets": "node scripts/snippets.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:live": "node scripts/check-live.mjs",
    "hooks": "git config core.hooksPath scripts/hooks"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/starlight": "0.42.8",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@scalar/api-reference": "1.76.4",
    "axe-core": "4.14.1"
  }
}
