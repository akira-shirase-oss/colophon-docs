---
/**
 * The API reference: Scalar's renderer over Colophon's own OpenAPI document (/openapi.json, copied
 * from colophon-cms main). Scalar runs from this site's own copy of its browser build, at the
 * version package.json pins, with its telemetry, hosted fonts and AI assistant switched off.
 * A full-width page of its own, since Scalar brings its own navigation.
 */
import spec from '../../data/openapi.json';
// The same tokens and type as every other page (D-210): Inter, and the byte copy of colophon-cms design/tokens.css.
import '@fontsource-variable/inter/opsz.css';
import '../../styles/tokens.css';

const title = 'API reference · Colophon Docs';
const description =
	'Every route of Colophon’s HTTP API (management, delivery, preview, media, auth), generated from the server’s OpenAPI document, with examples and try-it.';
const canonical = new URL('/api/reference/', Astro.site).href;
const paths = Object.keys(spec.paths).length;
const operations = Object.values(spec.paths).reduce(
	(sum: number, item) => sum + Object.keys(item as object).filter((key) => ['get', 'post', 'put', 'patch', 'delete'].includes(key)).length,
	0,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="article" />
		<meta property="og:site_name" content="Colophon Docs" />
		<meta property="og:image" content={new URL('/og.png', Astro.site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			// The docs' own theme choice, so this page opens in the same light or dark.
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('starlight-theme');
				} catch {}
				const dark = stored === 'dark' || ((stored === null || stored === 'auto' || stored === '') && matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
				// The tokens' dark theme is the `.dark` class.
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>
		<style is:global>
			/* Every colour is a token role, by its own name (never an alias that could shadow one); the tokens switch
			   with the `.dark` class. */
			:root {
				color-scheme: light;
			}
			:root.dark {
				color-scheme: dark;
			}
			html,
			body {
				margin: 0;
				background: var(--background);
				color: var(--foreground);
				font-family: var(--font-sans);
			}
			.ref-bar {
				position: sticky;
				top: 0;
				z-index: 20;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 1rem;
				padding: 0.625rem 16px;
				background: var(--background);
				border-bottom: 1px solid var(--border);
				font-size: 0.875rem;
			}
			.ref-bar a {
				color: inherit;
				text-decoration: none;
			}
			.ref-home {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 600;
				font-family: var(--font-title);
				font-weight: 400;
			}
			.ref-home svg {
				width: 18px;
				height: 19px;
			}
			.ref-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				margin-inline-start: auto;
				color: var(--muted-foreground);
			}
			.ref-links a:hover,
			.ref-home:hover {
				color: var(--link);
			}
			.ref-note {
				margin: 0;
				padding: 0.625rem 16px;
				font-size: 0.8125rem;
				line-height: 1.5;
				color: var(--muted-foreground);
				border-bottom: 1px solid var(--border);
			}
			.ref-note code {
				font-size: 0.95em;
			}
			.ref-note a {
				color: var(--link);
			}
			noscript p {
				padding: 1rem 16px;
			}
		</style>
	</head>
	<body>
		<header class="ref-bar">
			<a class="ref-home" href="/">
				<svg viewBox="0 0 292 310" aria-hidden="true"><path fill="currentColor" d="M87 0H232L292 60L232 120L194 82H130L87 125V185L130 228H194L232 190L292 250L232 310H87L0 223V87Z"></path></svg>
				Colophon Docs
			</a>
			<span aria-hidden="true">/</span>
			<span>API reference</span>
			<nav class="ref-links" aria-label="Docs">
				<a href="/api/">APIs overview</a>
				<a href="/api/authentication/">Authentication</a>
				<a href="/openapi.json">openapi.json</a>
			</nav>
		</header>
		<p class="ref-note">
			{operations} operations on {paths} paths, generated from the OpenAPI document Colophon serves at <code>/openapi.json</code> (version {spec.info.version}).
			The examples call <code>https://cms.example.com</code>, a reserved example domain; pick <strong>the quick start on this machine</strong>
			under <strong>Server</strong>, or set <strong>Your Colophon URL</strong> on any API page and it comes first here. Colophon's API doesn't
			answer browser requests from other sites, except on its preview routes, so <strong>Test Request</strong> from this page reaches your server only if it
			allows this origin: otherwise copy the request as <code>curl</code> from the code samples. Put a token in <strong>Authentication</strong> only for
			a local or test server. <a href="/api/authentication/">Which credential each route takes</a>.
		</p>
		<div id="reference"></div>
		<noscript><p>The interactive reference needs JavaScript. The document itself is at <a href="/openapi.json">/openapi.json</a>.</p></noscript>
		<script type="module" is:inline>
			import { createApiReference } from '/scalar/standalone.esm.js';
			// The reader's own server, if they set one on an API page (src/lib/your-url.ts holds the
			// same rule: https, or http for this machine; the origin only). Kept in this browser.
			const servers = [
				{ url: 'https://cms.example.com', description: 'Your Colophon (an example domain: enter yours on any API page)' },
				{ url: 'http://localhost:8080', description: 'The quick start on this machine' },
			];
			try {
				const stored = new URL(localStorage.getItem('colophon-docs:server') ?? '');
				const local = ['localhost', '127.0.0.1', '[::1]'].includes(stored.hostname);
				if (stored.protocol === 'https:' || (stored.protocol === 'http:' && local)) {
					servers.unshift({ url: stored.origin, description: 'Your Colophon' });
				}
			} catch {}
			const dark = document.documentElement.dataset.theme === 'dark';
			createApiReference('#reference', {
				url: '/openapi.json',
				servers,
				authentication: { preferredSecurityScheme: 'apiToken' },
				defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
				darkMode: dark,
				hideDarkModeToggle: true,
				withDefaultFonts: false,
				telemetry: false,
				showDeveloperTools: 'never',
				agent: { disabled: true },
				hideClientButton: false,
				persistAuth: false,
				// No request proxy. Test Request goes straight from the reader's browser to the server they
				// chose, never through proxy.scalar.com. Scalar 1.76 uses an explicit proxyUrl as given, and an
				// empty one means no proxy. Left unset, it falls back to its hosted proxy only in its own
				// "web" layout, which this page doesn't use. The empty value pins that down across upgrades,
				// and CI's privacy job (scripts/check-privacy.mjs) fails if a version starts proxying anyway. It
				// tries a remote https server as well as a local one, because Scalar never proxies localhost.
				proxyUrl: '',
				metaData: { title: 'API reference · Colophon Docs' },
				customCss: `
					.scalar-app, .scalar-api-reference { --scalar-font: var(--font-sans); --scalar-font-code: var(--font-mono); --scalar-radius: calc(var(--radius) - 8px); --scalar-radius-lg: calc(var(--radius) - 4px); }
					.light-mode, .dark-mode {
						--scalar-color-1: var(--foreground); --scalar-color-2: var(--foreground); --scalar-color-3: var(--muted-foreground);
						--scalar-color-accent: var(--link); --scalar-background-1: var(--background); --scalar-background-2: var(--muted);
						--scalar-background-3: var(--secondary); --scalar-background-accent: var(--brand-soft); --scalar-border-color: var(--border);
						/* Methods and code in the status inks, which read on both grounds in both themes. */
						--scalar-color-blue: var(--brand-ink); --scalar-color-purple: var(--changed-ink); --scalar-color-green: var(--live-ink);
						--scalar-color-orange: var(--pending-ink); --scalar-color-yellow: var(--pending-ink); --scalar-color-red: var(--attention-ink);
					}
				`,
			});
		</script>
	</body>
</html>
