---
/**
 * The API reference: Scalar's renderer over Colophon's own OpenAPI document (/openapi.json, copied
 * from colophon-cms main). Scalar runs from this site's own copy of its browser build, at the
 * version package.json pins, with its telemetry, hosted fonts and AI assistant switched off.
 * A full-width page of its own, since Scalar brings its own navigation.
 */
import spec from '../../data/openapi.json';

const title = 'API reference · Colophon Docs';
const description =
	'Every route of Colophon’s HTTP API — management, delivery, preview, media and auth — generated from the OpenAPI document the server is built from, with request examples and try-it.';
const canonical = new URL('/api/reference/', Astro.site).href;
const paths = Object.keys(spec.paths).length;
const operations = Object.values(spec.paths).reduce(
	(sum: number, item) => sum + Object.keys(item as object).filter((key) => ['get', 'post', 'put', 'patch', 'delete'].includes(key)).length,
	0,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline>
			// The docs' own theme choice, so this page opens in the same light or dark.
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('starlight-theme');
				} catch {}
				const dark = stored === 'dark' || ((stored === null || stored === 'auto' || stored === '') && matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			})();
		</script>
		<style is:global>
			@font-face {
				font-family: 'Geist';
				src: url('/fonts/geist-400.woff2') format('woff2');
				font-weight: 400;
				font-display: swap;
			}
			@font-face {
				font-family: 'Geist';
				src: url('/fonts/geist-500.woff2') format('woff2');
				font-weight: 500;
				font-display: swap;
			}
			@font-face {
				font-family: 'Geist';
				src: url('/fonts/geist-600.woff2') format('woff2');
				font-weight: 600;
				font-display: swap;
			}
			:root {
				--ink: #0a0a0a;
				--muted: #5e5e5e;
				--line: #e5e5e5;
				--bg: #ffffff;
				--accent: #33558a;
				color-scheme: light;
			}
			:root[data-theme='dark'] {
				--ink: #f5f5f5;
				--muted: #9c9c9c;
				--line: #2a2a2a;
				--bg: #121212;
				--accent: #9fb6e0;
				color-scheme: dark;
			}
			html,
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
			}
			.ref-bar {
				position: sticky;
				top: 0;
				z-index: 20;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 1rem;
				padding: 0.625rem 16px;
				background: var(--bg);
				border-bottom: 1px solid var(--line);
				font-size: 0.875rem;
			}
			.ref-bar a {
				color: inherit;
				text-decoration: none;
			}
			.ref-home {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 600;
				font-family: 'DM Sans', 'Geist', sans-serif;
			}
			.ref-home svg {
				width: 18px;
				height: 19px;
			}
			.ref-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				margin-inline-start: auto;
				color: var(--muted);
			}
			.ref-links a:hover,
			.ref-home:hover {
				color: var(--accent);
			}
			.ref-note {
				margin: 0;
				padding: 0.625rem 16px;
				font-size: 0.8125rem;
				line-height: 1.5;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
			}
			.ref-note code {
				font-size: 0.95em;
			}
			.ref-note a {
				color: var(--accent);
			}
			noscript p {
				padding: 1rem 16px;
			}
		</style>
	</head>
	<body>
		<header class="ref-bar">
			<a class="ref-home" href="/">
				<svg viewBox="0 0 292 310" aria-hidden="true"><path fill="currentColor" d="M87 0H232L292 60L232 120L194 82H130L87 125V185L130 228H194L232 190L292 250L232 310H87L0 223V87Z"></path></svg>
				Colophon Docs
			</a>
			<span aria-hidden="true">/</span>
			<span>API reference</span>
			<nav class="ref-links" aria-label="Docs">
				<a href="/api/">APIs overview</a>
				<a href="/api/authentication/">Authentication</a>
				<a href="/openapi.json">openapi.json</a>
			</nav>
		</header>
		<p class="ref-note">
			{operations} operations on {paths} paths, generated from the OpenAPI document Colophon serves at <code>/openapi.json</code> (version {spec.info.version}).
			The server address is <code>http://localhost:8080</code>, the quick start's; change it under <strong>Server</strong>. Colophon's API doesn't
			answer browser requests from other sites, except on its preview routes, so <strong>Test Request</strong> from this page reaches your server only if it
			allows this origin: otherwise copy the request as <code>curl</code> from the code samples. Put a token in <strong>Authentication</strong> only for
			a local or test server. <a href="/api/authentication/">Which credential each route takes</a>.
		</p>
		<div id="reference"></div>
		<noscript><p>The interactive reference needs JavaScript. The document itself is at <a href="/openapi.json">/openapi.json</a>.</p></noscript>
		<script type="module" is:inline>
			import { createApiReference } from '/scalar/standalone.esm.js';
			const dark = document.documentElement.dataset.theme === 'dark';
			createApiReference('#reference', {
				url: '/openapi.json',
				servers: [{ url: 'http://localhost:8080', description: 'The quick start on this machine' }],
				authentication: { preferredSecurityScheme: 'apiToken' },
				defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
				darkMode: dark,
				hideDarkModeToggle: true,
				withDefaultFonts: false,
				telemetry: false,
				showDeveloperTools: 'never',
				agent: { disabled: true },
				hideClientButton: false,
				persistAuth: false,
				// No request proxy. Test Request goes straight from the reader's browser to the server they
				// chose, never through proxy.scalar.com. Scalar 1.76 uses an explicit proxyUrl as given, and an
				// empty one means no proxy. Left unset, it falls back to its hosted proxy only in its own
				// "web" layout, which this page doesn't use. The empty value pins that down across upgrades,
				// and CI's privacy job (scripts/check-privacy.mjs) fails if a version starts proxying anyway. It
				// tries a remote https server as well as a local one, because Scalar never proxies localhost.
				proxyUrl: '',
				metaData: { title: 'API reference · Colophon Docs' },
				customCss: `
					.scalar-app, .scalar-api-reference { --scalar-font: 'Geist', ui-sans-serif, system-ui, sans-serif; --scalar-font-code: ui-monospace, SFMono-Regular, Menlo, monospace; }
					.light-mode { --scalar-color-accent: #33558a; --scalar-background-1: #ffffff; --scalar-color-3: #636363; }
					.dark-mode { --scalar-color-accent: #9fb6e0; --scalar-background-1: #121212; --scalar-color-3: #a3a3a3; }
				`,
			});
		</script>
	</body>
</html>
