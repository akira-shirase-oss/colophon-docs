---
/**
 * The changelog: one file per change in src/content/changelog, newest first, grouped by month.
 * Each entry has an anchor (its file name), a type and the areas it touches; the filter is a few
 * lines of script that hide what doesn't match, and the page works without it.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { render } from 'astro:content';
import { CHANGE_AREAS, CHANGE_TYPES } from '../../content.config';
import { anchorOf, byMonth, changes, dayOf } from '../../lib/changelog';

const entries = await changes();
const months = byMonth(entries);
const rendered = new Map(await Promise.all(entries.map(async (entry) => [entry.id, (await render(entry)).Content] as const)));
const count = (type: string) => entries.filter((entry) => entry.data.type === type).length;
const countArea = (area: string) => entries.filter((entry) => entry.data.areas.includes(area as never)).length;
---

<StarlightPage
	frontmatter={{
		title: 'Changelog',
		description: 'What changed in Colophon, newest first: features, improvements, fixes, security fixes and breaking changes, each dated and linked to the docs.',
		editUrl: 'https://github.com/akira-shirase-oss/colophon-docs/tree/main/src/content/changelog',
		tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
		pagefind: true,
	}}
	headings={months.map((month) => ({ depth: 2, slug: `m-${month.id}`, text: month.label }))}
>
	<p class="lede">
		Every change that reached Colophon's <code>main</code> branch and that you can see or use, newest first. Each
		entry is dated the day it landed, labelled with its type and the areas it touches, and links to the docs. Colophon
		hasn't made its first release yet, so entries are grouped by month rather than by version.{' '}
		<a href="/changelog/rss.xml">Subscribe with RSS</a>.
	</p>

	<div class="filters not-content" id="changelog-filters" hidden>
		<div role="group" aria-label="Filter by type">
			<button type="button" class="filter" data-filter="all" aria-pressed="true">All <span>{entries.length}</span></button>
			{CHANGE_TYPES.filter((type) => count(type) > 0).map((type) => (
				<button type="button" class="filter" data-filter={`type:${type}`} aria-pressed="false">
					{type} <span>{count(type)}</span>
				</button>
			))}
		</div>
		<div role="group" aria-label="Filter by area">
			{CHANGE_AREAS.filter((area) => countArea(area) > 0).map((area) => (
				<button type="button" class="filter" data-filter={`area:${area}`} aria-pressed="false">
					{area} <span>{countArea(area)}</span>
				</button>
			))}
		</div>
		<p class="filter-status" aria-live="polite"></p>
	</div>

	{
		months.map((month) => (
			<section class="changelog-month-block" data-month>
				<h2 id={`m-${month.id}`} class="changelog-month">
					{month.label}
				</h2>
				{month.entries.map((entry) => {
					const Content = rendered.get(entry.id)!;
					const id = anchorOf(entry);
					return (
						<article class="change" id={id} data-type={entry.data.type} data-areas={entry.data.areas.join(',')}>
							<header>
								<p class="change-meta not-content">
									<time datetime={entry.data.date.toISOString().slice(0, 10)}>{dayOf(entry.data.date)}</time>
									<span class={`label label-${entry.data.type.toLowerCase()}`}>{entry.data.type}</span>
									{entry.data.areas.map((area) => (
										<span class="area">{area}</span>
									))}
								</p>
								<h3>
									<a href={`#${id}`} class="change-anchor">
										{entry.data.title}
									</a>
								</h3>
							</header>
							<div class="change-body">
								<Content />
							</div>
							{entry.data.removal && (
								<p class="removal">
									Stops working on <time datetime={entry.data.removal.toISOString().slice(0, 10)}>{dayOf(entry.data.removal)}</time>.
								</p>
							)}
							{entry.data.docs.length > 0 && (
								<p class="change-docs">
									Read more:{' '}
									{entry.data.docs.map((link, index) => (
										<>
											{index > 0 && ' · '}
											<a href={link.href}>{link.label}</a>
										</>
									))}
								</p>
							)}
						</article>
					);
				})}
			</section>
		))
	}
</StarlightPage>

<script>
	const bar = document.getElementById('changelog-filters');
	if (bar) {
		bar.hidden = false;
		const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
		const status = bar.querySelector('.filter-status');
		const apply = (filter: string) => {
			let shown = 0;
			for (const article of document.querySelectorAll<HTMLElement>('article.change')) {
				const [kind, value] = filter.split(':');
				const match = filter === 'all' || (kind === 'type' ? article.dataset.type === value : (article.dataset.areas ?? '').split(',').includes(value ?? ''));
				article.hidden = !match;
				if (match) shown += 1;
			}
			for (const month of document.querySelectorAll<HTMLElement>('[data-month]')) {
				month.hidden = month.querySelector('article.change:not([hidden])') === null;
			}
			for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
			if (status) status.textContent = filter === 'all' ? '' : `Showing ${shown} of ${buttons[0]?.querySelector('span')?.textContent ?? ''} changes.`;
		};
		for (const button of buttons) button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
	}
</script>

<style>
	.lede {
		color: var(--sl-color-gray-2);
	}
	.filters {
		display: grid;
		gap: 0.5rem;
		margin-block: 1.5rem 0.5rem;
	}
	.filters [role='group'] {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	.filter {
		font: inherit;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		padding: 0.2rem 0.65rem;
		cursor: pointer;
	}
	.filter span {
		color: var(--sl-color-gray-3);
	}
	.filter[aria-pressed='true'] {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.filter-status {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		min-height: 1.2em;
	}
	.changelog-month {
		margin-top: 2.5rem;
		padding-bottom: 0.375rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.change {
		margin-top: 1.75rem;
		scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
	}
	.change[hidden],
	[data-month][hidden] {
		display: none;
	}
	.change header h3 {
		margin-top: 0.25rem;
		font-size: var(--sl-text-h4);
	}
	.change-anchor {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.change-anchor:hover {
		text-decoration: underline;
	}
	.change-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.change-meta time {
		margin-inline-end: 0.25rem;
		font-variant-numeric: tabular-nums;
	}
	.label,
	.area {
		border-radius: 999px;
		padding: 0.05rem 0.5rem;
		line-height: 1.5;
		border: 1px solid var(--sl-color-gray-5);
	}
	.label {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.label-feature {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.label-security,
	.label-breaking,
	.label-deprecation {
		border-color: var(--c-warn);
		color: var(--c-warn);
	}
	.label-fix {
		border-color: var(--c-live);
		color: var(--c-live);
	}
	.change-docs,
	.removal {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
